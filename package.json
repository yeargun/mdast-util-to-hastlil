{
  "name": "@itslil/mdast-util-to-hast",
  "version": "13.2.0",
  "description": "mdast-util-to-hast reimplemented in LilScript",
  "keywords": [
    "mdast",
    "hast",
    "unist",
    "html",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/mdast-util-to-hastlil/",
  "bugs": "https://github.com/yeargun/mdast-util-to-hastlil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/mdast-util-to-hastlil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/to-hast.cjs",
  "module": "./dist/to-hast.esm.js",
  "types": "./dist/to-hast.d.ts",
  "unpkg": "./dist/to-hast.umd.js",
  "jsdelivr": "./dist/to-hast.umd.js",
  "exports": {
    ".": {
      "types": "./dist/to-hast.d.ts",
      "import": "./dist/to-hast.esm.js",
      "require": "./dist/to-hast.cjs",
      "default": "./dist/to-hast.esm.js"
    },
    "./closed": "./dist/to-hast.closed.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/to-hast.esm.js",
    "dist/to-hast.cjs",
    "dist/to-hast.umd.js",
    "dist/to-hast.closed.js",
    "dist/to-hast.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --compile",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test test/*.test.mjs",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check:pack && npm run check:site"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
